{
  "containerDefinitions": [
    {
      "name": "vertice-api",
      "image": "096571798756.dkr.ecr.us-east-2.amazonaws.com/vertice-api:8b78c98e0178",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 9090,
          "hostPort": 9090,
          "protocol": "tcp",
          "name": "grpc",
          "appProtocol": "grpc"
        },
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "VERTICE_ENV",
          "value": "prod"
        },
        {
          "name": "DB_USERNAME",
          "value": "vertice_app"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:aws-wrapper:postgresql://vertice.cluster-chaku2mwuq8f.us-east-2.rds.amazonaws.com:5432/vertice"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "aws"
        },
        {
          "name": "DB_PASSWORD",
          "value": ""
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:096571798756:secret:vertice/prod/jwt-secret-YruFsd"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vertice-api",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "api"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fs http://localhost:8080/actuator/health/liveness || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      },
      "systemControls": []
    }
  ],
  "family": "vertice-api",
  "taskRoleArn": "arn:aws:iam::096571798756:role/vertice-api-task",
  "executionRoleArn": "arn:aws:iam::096571798756:role/vertice-api-exec",
  "networkMode": "awsvpc",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
